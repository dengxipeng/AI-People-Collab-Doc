# ============ MCP 客户端 / 网页编辑器（本地开发用）============
# Supabase 项目 URL（Dashboard → Settings → API）
SUPABASE_URL=https://<your-project-ref>.supabase.co
# 公开 key（sb_publishable_... 或旧版 anon key），设计上就是公开的，可安全出现在前端
SUPABASE_PUBLISHABLE_KEY=

# ============ Edge Function 部署 ============
# SUPABASE_URL 与 SUPABASE_SERVICE_ROLE_KEY 由平台在函数运行时自动注入，无需手动设置
# 如需自定义文档链接域名，可配置 secret（当前代码中未实际使用，可选）：
#   supabase secrets set WEB_URL=https://<your-project-ref>.supabase.co
WEB_URL=
